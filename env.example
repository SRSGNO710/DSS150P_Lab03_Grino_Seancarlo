# Copy to .env and replace every change_me value:   cp .env.example .env
# .env is git-ignored. Never commit real credentials.
#
# POSTGRES_HOST depends on WHERE the command runs:
#   localhost  -> python -m src.cli ... on your own machine (host-side)
#   postgres   -> inside Docker (pipeline / Airflow containers). docker-compose.yml
#                 overrides this automatically, so keep "localhost" here.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=dss150p
POSTGRES_USER=dss150p
POSTGRES_PASSWORD=change_me

# Airflow (Goal 4). AIRFLOW_UID: on Linux set to the output of `id -u`; 50000 is fine on Docker Desktop.
AIRFLOW_UID=50000
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=admin

# Optional. Normally left empty: the CLI generates run_<timestamp>_<id>, and Airflow
# passes its own run_id so every task in one DAG run shares one pipeline_run_id.
PIPELINE_RUN_ID=

# Optional, noncommitted override of the source folder (used for the Goal 4
# deliberate-failure experiment). Leave empty to use config/settings.yml.
PIPELINE_SOURCE_DIR=
